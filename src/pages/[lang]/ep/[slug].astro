---
import Base from "../../../layouts/Base.astro";
import EpisodeList from "../../../components/EpisodeList.astro";
import Practice from "../../../components/Practice.astro";
import ActivityBox from "../../../components/Activity.astro";
import fs from "node:fs";
import { LANGS, type Lang, STAGES, SEEDS, GRADE_LABEL, episodes, byId, t, pickText, videoOf } from "../../../data/site";

export function getStaticPaths() {
  return LANGS.flatMap((lang) => episodes.map((e) => ({ params: { lang, slug: e.slug } })));
}
const lang = Astro.params.lang as Lang;
const e = episodes.find((x) => x.slug === Astro.params.slug)!;
const stage = STAGES[e.stage];
const title = pickText(e.title, lang);
const aha = pickText(e.aha, lang);
const insight = pickText(e.insight, lang);
const mix = pickText(e.misconception, lang);
const non = pickText(e.non_example, lang);
const video = videoOf(e.slug, lang);
const hasPlay = fs.existsSync(`public/play/${e.slug}.html`);
const P = e.practice;
const order = [...episodes].sort((a, b) => a.id - b.id);
const at = order.findIndex((x) => x.slug === e.slug);
const prev = order[at - 1], next = order[at + 1];
const hook = e.next_hook ? pickText(e.next_hook, lang) : "";
const related = e.callbacks.map((n) => byId.get(n)).filter((x) => x !== undefined);
---

<Base lang={lang} title={title} description={aha || insight || stage.question[lang]} path={`ep/${e.slug}/`} image={video?.poster}>
  <article class="narrow">
    <p class="crumbs">
      <a href={`/${lang}/stages/${e.stage}/`}>{t("stage", lang)} {e.stage} · {stage.name[lang]}</a> / #{e.id}
    </p>
    <h1>{title}</h1>
    {aha && <p class="lead">{aha}</p>}

    <div class="chips">
      {
        e.seeds.map((id) => {
          const s = SEEDS.find((x) => x.id === id)!;
          return (
            <a class="chip" href={`/${lang}/seeds/${id}/`}>
              {id} · {s.name[lang]}
            </a>
          );
        })
      }
    </div>

    {
      P.before && P.before.length > 0 && (
        <section class="before">
          <h2>{t("beforeWatch", lang)}</h2>
          <p class="sub">{t("beforeWatchLead", lang)}</p>
          <Practice items={P.before} lang={lang} />
        </section>
      )
    }

    <div class={`video${video || e.youtube ? " has" : ""}`}>
      {
        video ? (
          <video controls preload="metadata" playsinline poster={video.poster} src={video.src} title={title}>
            <a href={video.src}>{t("downloadVideo", lang)}</a>
          </video>
        ) : e.youtube ? (
          <iframe
            src={`https://www.youtube-nocookie.com/embed/${e.youtube}`}
            title={title}
            allow="accelerometer; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
            loading="lazy"
          />
        ) : (
          <div>
            <span class={`badge ${e.phase}`}>{t(e.phase, lang)}</span>
            <p style="margin-top:0.75rem">{t("videoSoon", lang)}</p>
          </div>
        )
      }
    </div>

    {
      insight && (
        <div class="block insight">
          <div class="label">{t("insight", lang)}</div>
          <p>{insight}</p>
        </div>
      )
    }
    {
      mix && (
        <div class="block mix">
          <div class="label">{t("misconception", lang)}</div>
          <p>{mix}</p>
        </div>
      )
    }
    {
      non && (
        <div class="block non">
          <div class="label">{t("nonExample", lang)}</div>
          <p>{non}</p>
        </div>
      )
    }

    {
      Object.keys(e.grade).length > 0 && (
        <div class="block">
          <div class="label">{t("grade", lang)}</div>
          <div class="chips">
            {Object.entries(e.grade).map(([k, v]) => (
              <span class="chip">
                {GRADE_LABEL[k]?.[lang] ?? k} {v}
              </span>
            ))}
          </div>
        </div>
      )
    }
  </article>

  {
    hasPlay && (
      <section class="play-embed">
        <h2>{t("tryIt", lang)}</h2>
        <p class="sub">{t("tryItLead", lang)}</p>
        <iframe
          id="play-frame"
          src={`/play/${e.slug}.html?lang=${lang}&embed=1`}
          title={`${t("tryIt", lang)} · ${title}`}
          loading="lazy"
        />
        <p class="open"><a href={`/play/${e.slug}.html?lang=${lang}`} target="_blank" rel="noopener">{t("openFull", lang)} ↗</a></p>
        <script is:inline>
          addEventListener("message", (m) => {
            const f = document.getElementById("play-frame");
            if (f && m.source === f.contentWindow && m.data && m.data.type === "play-height") f.style.height = m.data.h + "px";
          });
        </script>
      </section>
    )
  }

  <article class="narrow">
    {e.activity && <ActivityBox a={e.activity} lang={lang} />}

    {
      (P.after_concept?.length || P.after_procedure?.length) && (
        <section class="practice-wrap">
          <h2>{t("practiceTitle", lang)}</h2>
          {P.after_concept?.length ? (<><h3>{t("pWhy", lang)}</h3><Practice items={P.after_concept} lang={lang} /></>) : null}
          {P.after_procedure?.length ? (<><h3>{t("pDo", lang)}</h3><Practice items={P.after_procedure} lang={lang} /></>) : null}
          {P.spaced?.length ? (
            <details class="later">
              <summary>{t("pLater", lang)}</summary>
              <p class="sub">{t("pLaterLead", lang)}</p>
              <Practice items={P.spaced} lang={lang} />
            </details>
          ) : null}
        </section>
      )
    }

    {
      hook && (
        <div class="block think">
          <div class="label">{t("thinkAbout", lang)}</div>
          <p>{hook}</p>
        </div>
      )
    }

    {
      e.transcript.length > 0 && (
        <details class="transcript">
          <summary>{t("transcript", lang)}</summary>
          {e.transcript.map((ln) => <p>{pickText(ln, lang)}</p>)}
        </details>
      )
    }

    <nav class="epnav" aria-label="episodes">
      {prev ? <a class="prev" href={`/${lang}/ep/${prev.slug}/`}><span>← {t("prevEp", lang)} · #{prev.id}</span>{pickText(prev.title, lang)}</a> : <span />}
      {next ? <a class="next" href={`/${lang}/ep/${next.slug}/`}><span>#{next.id} · {t("nextEp", lang)} →</span>{pickText(next.title, lang)}</a> : <span />}
    </nav>
  </article>

  {
    related.length > 0 && (
      <section>
        <h2>{t("related", lang)}</h2>
        <EpisodeList eps={related} lang={lang} />
      </section>
    )
  }
</Base>
